<Window x:Class="Practica1AJGE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica1AJGE"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Background="#12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="25,10,25,0">
                <TextBlock Text="mi perfil" DockPanel.Dock="Right" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TIENDA" Foreground="#6366F1" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="COMUNIDAD" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SOPORTE" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Grid.Column="0" Background="#1A1D27" BorderBrush="#2D3243" BorderThickness="1.5" CornerRadius="22" Margin="25,10,15,25" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="10" Padding="10,10" Margin="0,10">
                        <TextBlock Text="Destacados" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#242838" CornerRadius="10" Padding="10,10" Margin="0,10">
                        <TextBlock Text="Mis juegos" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#242838" CornerRadius="10" Padding="10,10" Margin="0,10">
                        <TextBlock Text="Configuración" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="#1A1D27" BorderBrush="#2D3243" BorderThickness="1.5" CornerRadius="22" Margin="10,10,25,25" Padding="25">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                    <Border Width="110" Height="110" Background="#242838" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" Margin="12,0">
                        <TextBlock Text="FC 27" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="110" Height="110" Background="#242838" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" Margin="12,0">
                        <TextBlock Text="GTA VI" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="110" Height="110" Background="#242838" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" Margin="12,0">
                        <TextBlock Text="CYBERPUNK" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
