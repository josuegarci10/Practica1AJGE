<Window x:Class="Practica1AJGE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica1AJGE"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Background="#12141A">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BARRA SUPERIOR -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="25,10,25,0">
                <Button x:Name="btnCerrarSesion" 
                        Content="Cerrar Sesión" 
                        Click="btnCerrarSesion_Click"
                        DockPanel.Dock="Right" 
                        Background="#DC2626" 
                        Foreground="White" 
                        FontWeight="Bold"
                        BorderThickness="0"
                        Padding="10,5"
                        Margin="15,0,0,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>

                <TextBlock Text="👤 Mi Perfil" DockPanel.Dock="Right" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TIENDA" Foreground="#6366F1" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="COMUNIDAD" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" Cursor="Hand"/>
                    <TextBlock Text="SOPORTE" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>

            <!-- MENÚ LATERAL -->
            <Border Grid.Row="1" Grid.Column="0" Background="#1A1D27" BorderBrush="#2D3243" BorderThickness="1.5" CornerRadius="22" Margin="25,10,15,25" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="10" Padding="10,12" Margin="0,10" Cursor="Hand">
                        <TextBlock Text="⭐ Destacados" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#242838" CornerRadius="10" Padding="10,12" Margin="0,10" Cursor="Hand">
                        <TextBlock Text="🎮 Mis juegos" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#242838" CornerRadius="10" Padding="10,12" Margin="0,10" Cursor="Hand">
                        <TextBlock Text="⚙️ Configuración" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ZONA DE JUEGOS CON PORTADAS REALES -->
            <Border Grid.Row="1" Grid.Column="1" Background="#1A1D27" BorderBrush="#2D3243" BorderThickness="1.5" CornerRadius="22" Margin="10,10,25,25" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="4"/>
                </Border.Effect>

                <Grid>
                    <TextBlock Text="Lanzamientos Recientes" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">

                        <!-- JUEGO 1: FC 27 -->
                        <StackPanel Margin="15,0" Cursor="Hand">
                            <Border Width="130" Height="180" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Images/easportsfc27.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.4" ShadowDepth="5"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="FC 27" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="EA Sports" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- JUEGO 2: GTA VI -->
                        <StackPanel Margin="15,0" Cursor="Hand">
                            <Border Width="130" Height="180" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Images/cover_gta6.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.4" ShadowDepth="5"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="GTA VI" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Rockstar" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- JUEGO 3: CYBERPUNK -->
                        <StackPanel Margin="15,0" Cursor="Hand">
                            <Border Width="130" Height="180" BorderBrush="#3B425A" BorderThickness="1.5" CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Images/cover.cyberpunk-2077.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.4" ShadowDepth="5"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="CYBERPUNK" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="CD Projekt" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>